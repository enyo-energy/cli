{
  "name": "@enyo-energy/cli",
  "version": "1.4.0",
  "description": "The Enyo CLI is a npm-based cli to publish and deploy your Enyo Energy Apps to our store.",
  "main": "index.js",
  "bin": {
    "enyo": "dist/index.js"
  },
  "scripts": {
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "build": "tsc --noEmit && duel --modules",
    "postbuild": "cp -r src/templates dist/"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enyo-energy/cli.git"
  },
  "author": "Kevin Kirch",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/enyo-energy/cli/issues"
  },
  "homepage": "https://github.com/enyo-energy/cli#readme",
  "dependencies": {
    "@enyo-energy/energy-app-sdk": "^1.8.0",
    "@types/ws": "^8.18.1",
    "commander": "^14.0.0",
    "express": "^5.1.0",
    "jiti": "^2.6.1",
    "jsmodbus": "^4.0.10",
    "undici": "^7.16.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@knighted/duel": "^2.1.5",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.13",
    "eslint": "^9.29.0",
    "prettier": "^3.5.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.34.1"
  },
  "volta": {
    "node": "22.20.0"
  }
}
